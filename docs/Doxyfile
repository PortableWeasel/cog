# @file Doxyfile
# @brief Doxygen configuration for the Cog project.
#
# Doxygen 1.9.8 minimum.
# Run `doxygen docs/Doxyfile` from the project root.

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
DOXYFILE_ENCODING         = UTF-8
PROJECT_NAME              = "Cog"
PROJECT_NUMBER            = 0.1.0
