digraph instruction_support {
  graph [fontname="DejaVu Sans", fontsize=20, rankdir=TB, bgcolor="white",
         pad=0.30, nodesep=0.32, ranksep=0.55, compound=true, splines=polyline,
         label="Cog instruction support — seven approved blocks\nIteration 5 · frontend-neutral loading + planned headless runtime; CLI stays a proof host", labelloc=t];
  node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", margin="0.15,0.11", color="#65758a", fillcolor="#fff2bf"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#53677d", arrowsize=0.7];

  sources [label="Explicit host / user / project roots\nAGENTS.md · agent Markdown · SKILL.md · resources\nOr caller-supplied UTF-8 blobs", fillcolor="#edf2f7"];
  subgraph cluster_ui {
    label="Frontend boundary (target)"; style=dashed; color="#8794a4";
    ui [label="Minimal CLI / test PoC / other UI\nArguments + input + rendering only\nNo skill/agent file loading or execution state"];
  }
  { rank=same; ui; sources; }

  subgraph cluster_main {
    label="Headless main / coordinator process — one owning service loop";
    fontname="DejaVu Sans"; fontsize=15; color="#3d83c6"; penwidth=2; style=dashed;
    subgraph cluster_instructions {
      label="Frontend-neutral cog::instructions · B1–B5"; color="#afc6df"; style=rounded;
      b1 [label="B1  Shared bounded source reader\ncog_instruction_source_reader_t\nExplicit roots · read / scope / scan quanta"];
      b2 [label="B2  AGENTS.md scope resolver\ncog_instruction_source_t\nRoot → target directory; no sibling rules"];
      b3 [label="B3  Named agent catalog\ncog_instruction_entry_t\nRole + model constraint + capability subset"];
      b4 [label="B4  Skills and activation\ncog_instruction_catalog_t\nMetadata first; selected bodies / resources"];
      blobs [label="Owned source views / caller blobs", shape=plaintext, style="", fontsize=10];
      { rank=same; b2; b3; b4; }
      b2 -> b3 -> b4 [style=invis, weight=20];
      b5 [label="B5  One prompt composer\ncog_instruction_snapshot_t\nOrdered fragments + effective static tool references"];
    }
    subgraph cluster_runtime {
      label="Planned cog::runtime extraction · fa56e22"; color="#afc6df"; style=rounded;
      b7 [label="B7  Snapshot lifecycle / runtime binding\ncog_instruction_manifest_t\nFull bounded catalog + exact resolved bytes"];
      app [label="Headless runtime boundary (planned)\nExtract existing policy / tool / turn / config loop\nAll send and preflight paths use one B5/B6 view"];
    }

    subgraph cluster_provider {
      label="cog::provider + cog::net"; color="#9bb7a0"; style=rounded;
      b6 [label="B6  Static provider template codec\ncog_provider_prompt_template_t / compiler_t\nStrict tool JSON + instruction role mapping"];
      provider [label="Existing provider + HTTPS transport\nNine callbacks · retained deltas / preflight\nOpaque continuation remains separate", fillcolor="#d9efdb", color="#41834a"];
    }

    subgraph cluster_services {
      label="Existing service libraries"; color="#9bb7a0"; style=rounded;
      core [label="cog::core\nSession / branch / ledger / event leases", fillcolor="#d9efdb", color="#41834a"];
      toolkit [label="cog::toolkit\nOriginal static descriptors\nWorkspace / process execution", fillcolor="#d9efdb", color="#41834a"];
      configobs [label="cog::config + cog::obs\nCandidate generations / diagnostics", fillcolor="#d9efdb", color="#41834a"];
      ipcorch [label="cog::ipc + cog::orchestrator\nAuthenticated native lifecycle / routing", fillcolor="#d9efdb", color="#41834a"];
      { rank=same; core; toolkit; configobs; ipcorch; }
    }
    durablegap [label="OPEN JOINED CONTRACT\nVersioned session context attachments\nAtomic result + context checkpoint / backend capability", fillcolor="#ffe0dc", color="#bd4b40"];
  }

  subgraph cluster_aux {
    label="Owned auxiliary process"; fontname="DejaVu Sans"; fontsize=15;
    color="#8b62b3"; style=dashed; penwidth=2;
    worker [label="Existing worker executor\nSame effective permissions / deadlines\nNo parent path or resolver authority", fillcolor="#eadff5", color="#8b62b3"];
    workergap [label="OPEN CONTRACT GAP\nVersioned instruction capsule + pinned catalog\nOn-demand resource ownership / ACK / wipe bounds", fillcolor="#ffe0dc", color="#bd4b40"];
  }

  store [label="Existing guarded checkpoint store\nImmutable generation + owner CAS", fillcolor="#d9efdb", color="#41834a"];
  llm [label="External LLM service\nSelected registered endpoint / model", fillcolor="#edf2f7"];

  sources -> b1 [label="bounded source jobs"];
  ui -> app [label="control / immutable views", dir=both, color="#3d83c6", style=dashed];
  sources -> blobs [label="caller blobs", style=dotted];
  b1 -> blobs;
  blobs -> b2; blobs -> b3; blobs -> b4;
  b2 -> b5; b3 -> b5; b4 -> b5;
  b5 -> b7 [label="resolved immutable view"];
  b7 -> app [label="pinned context"];
  app -> b6 [label="same input for send / preflight"];
  b6 -> provider [label="owned request copy"];
  provider -> llm [label="HTTPS (existing)"];
  toolkit -> b5 [label="same effective descriptors", constraint=false];
  app -> toolkit [color="#41834a"];
  app -> core [color="#41834a"];
  configobs -> app [constraint=false, color="#41834a"];
  b7 -> durablegap [style=dashed, color="#bd4b40"];
  durablegap -> store [style=dashed, color="#bd4b40"];
  core -> store [label="existing v2 persistence", color="#41834a"];
  app -> ipcorch [color="#41834a"];
  ipcorch -> worker [label="existing authenticated control", color="#41834a"];
  b7 -> workergap [label="resolved bytes, not host paths", style=dashed, color="#bd4b40"];
  workergap -> worker [style=dashed, color="#bd4b40"];

  summary [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#91a0b0" BGCOLOR="white">
      <TR><TD COLSPAN="3" BGCOLOR="#edf2f7"><B>Library / header ownership</B></TD></TR>
      <TR><TD ALIGN="LEFT"><B>Owner</B></TD><TD ALIGN="LEFT"><B>Headers</B></TD><TD ALIGN="LEFT"><B>Key contracts / types</B></TD></TR>
      <TR><TD ALIGN="LEFT">cog::instructions · draft</TD><TD ALIGN="LEFT">cog/instruction_source.h<BR/>cog/instructions.h</TD><TD ALIGN="LEFT">reader · catalog · snapshot · manifest; no UI/provider dependency</TD></TR>
      <TR><TD ALIGN="LEFT">cog::runtime · planned extraction</TD><TD ALIGN="LEFT">Public runtime header still to author</TD><TD ALIGN="LEFT">control / progress / execution ownership; CLI consumes views</TD></TR>
      <TR><TD ALIGN="LEFT">cog::provider · draft + existing</TD><TD ALIGN="LEFT">cog/provider_prompt.h<BR/>provider_vtable.h · provider_request.h</TD><TD ALIGN="LEFT">static template · compiler · request / deltas</TD></TR>
      <TR><TD ALIGN="LEFT">cog::core · existing / neutral draft</TD><TD ALIGN="LEFT">prompt.h · session.h · session_store.h · agent.h</TD><TD ALIGN="LEFT">neutral bundle + session / checkpoint / agent; context binding open</TD></TR>
      <TR><TD ALIGN="LEFT">cog::toolkit + core descriptors</TD><TD ALIGN="LEFT">tool.h · toolkit_exec.h · workspace.h</TD><TD ALIGN="LEFT">original descriptors · guarded async effects</TD></TR>
      <TR><TD ALIGN="LEFT">cog::ipc / cog::orchestrator</TD><TD ALIGN="LEFT">ipc.h · orchestrator.h</TD><TD ALIGN="LEFT">peer / worker identity; instruction capsule still open</TD></TR>
      <TR><TD ALIGN="LEFT">cog::config / cog::net / cog::obs</TD><TD ALIGN="LEFT">config.h · net.h · obs.h</TD><TD ALIGN="LEFT">generations · bounded transport · sanitized observation</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="LEFT">Green: delivered baseline · Yellow: header design · Red: open joined contract · Blue/Purple: process boundaries</TD></TR>
    </TABLE>
  >];
  store -> summary [style=invis]; llm -> summary [style=invis]; worker -> summary [style=invis];
}
