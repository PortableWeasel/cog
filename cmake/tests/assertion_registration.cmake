cmake_minimum_required(VERSION 3.16)
# Consume CMake's generated registration, not a hand-maintained test-name list.
# Defining these commands allows a read-only traversal in script mode (3.16+).
include("${ASSERTION_MANIFEST}")
set_property(GLOBAL PROPERTY COG_AUDITED_ASSERTIONS 0)
function(add_test name)
    foreach(argument IN LISTS ARGN)
        foreach(executable IN LISTS COG_PROJECT_EXECUTABLES)
            # Match literal paths inside wrappers too (-DNAME[:TYPE]=path,
            # --executable=path, quoted shell arguments). A suffix boundary
            # keeps target 'probe' distinct from target 'probe_long'.
            set(rest "${argument}")
            set(matched FALSE)
            while(TRUE)
                string(FIND "${rest}" "${executable}" position)
                if(position LESS 0)
                    break()
                endif()
                string(LENGTH "${executable}" path_length)
                string(LENGTH "${rest}" argument_length)
                math(EXPR after "${position} + ${path_length}")
                if(after EQUAL argument_length)
                    set(matched TRUE)
                    break()
                endif()
                string(SUBSTRING "${rest}" ${after} 1 suffix)
                if(suffix MATCHES "[ \t\"';,:=]")
                    set(matched TRUE)
                    break()
                endif()
                string(SUBSTRING "${rest}" ${after} -1 rest)
            endwhile()
            if(NOT matched)
                continue()
            endif()
            if(executable IN_LIST COG_ASSERTION_EXECUTABLES)
                get_property(count GLOBAL PROPERTY COG_AUDITED_ASSERTIONS)
                math(EXPR count "${count} + 1")
                set_property(GLOBAL PROPERTY COG_AUDITED_ASSERTIONS ${count})
            elseif(NOT executable IN_LIST COG_PRODUCTION_EXECUTABLES)
                message(FATAL_ERROR "Registered test ${name} uses unclassified executable ${executable}; enable its test assertions")
            endif()
        endforeach()
    endforeach()
endfunction()
function(set_tests_properties)
endfunction()
function(subdirs)
    foreach(directory IN LISTS ARGN)
        include("${CMAKE_CURRENT_LIST_DIR}/${directory}/CTestTestfile.cmake")
    endforeach()
endfunction()
include("${BUILD_ROOT}/CTestTestfile.cmake")

get_property(count GLOBAL PROPERTY COG_AUDITED_ASSERTIONS)
if(count EQUAL 0)
    message(FATAL_ERROR "No assertion-enabled executable registrations were inspected")
endif()
